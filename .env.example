# 监听地址/端口
HOST=0.0.0.0
PORT=3100

# 管理接口口令：调用 /admin/* 与 /manage/* 需要 Authorization: Bearer <ADMIN_TOKEN>
# 首次启动若未设置，会自动生成并打印在日志里（落盘到 .data/admin-token）
ADMIN_TOKEN=

# 数据目录（存放 Cursor token 与代理 Key），默认 ./.data
DATA_DIR=

# 伪装的 Cursor 客户端版本与时区（一般不用改）
CURSOR_CLIENT_VERSION=3.12.10
CURSOR_TIMEZONE=Asia/Shanghai

# 对话走的现代 agent 协议（agentn.api5，CLI 客户端）
CURSOR_AGENT_CLIENT_VERSION=cli-2026.01.28-fd13201
# 流式：拿到内容后空闲多少毫秒判定结束；单请求最长时长；首 token 超时
AGENT_IDLE_MS=6000
AGENT_HARD_CAP_MS=180000
AGENT_FIRST_TOKEN_MS=60000

# 可选：上游走 HTTP 代理（例如公司外网需要代理时）
# CURSOR_HTTP_PROXY=http://127.0.0.1:7890

# ===== 账号调度 / 防封（默认高并发，可调回保守）=====
ACCOUNT_MIN_INTERVAL_MS=0
ACCOUNT_MAX_CONCURRENCY=64
ACCOUNT_JITTER_MS=0
ACCOUNT_COOLDOWN_429_MS=60000
ACCOUNT_QUARANTINE_MS=1800000
ACCOUNT_MAX_FAILURES=3
PROXY_MAX_ATTEMPTS=3
ACCOUNT_ACQUIRE_TIMEOUT_MS=30000

# 可选：内置 VPN(Mihomo) 内核直链（不设则自动从 GitHub release 下载）
# MIHOMO_URL=
