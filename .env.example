# 监听地址/端口
HOST=0.0.0.0
PORT=3100

# 管理接口口令：调用 /admin/* 与 /manage/* 需要 Authorization: Bearer <ADMIN_TOKEN>
# 首次启动若未设置，会自动生成并打印在日志里（落盘到 .data/admin-token）
ADMIN_TOKEN=

# 数据目录（存放 Cursor token 与代理 Key），默认 ./.data
DATA_DIR=

# 伪装的 Cursor 客户端版本与时区（一般不用改）
CURSOR_CLIENT_VERSION=3.12.10
CURSOR_TIMEZONE=Asia/Shanghai

# 对话走的现代 agent 协议（agentn.api5，CLI 客户端）
CURSOR_AGENT_CLIENT_VERSION=cli-2026.01.28-fd13201
# 流式收尾：
#   AGENT_FINISH_IDLE_MS 上游回写会话记录（本轮生成结束）后的收尾窗口。
#                        上游永不关连接、只每 10s 发心跳，所以靠这个短窗口收残余帧。
#                        调大更稳妥，调小更跟手。
#   AGENT_IDLE_MS        兜底空闲超时，仅在识别不到结束信号时才会用到
AGENT_FINISH_IDLE_MS=400
AGENT_IDLE_MS=6000
# 单轮对话的时长兜底，防「一直吐、永远不停」的失控流。
# 卡住的流由 AGENT_IDLE_MS 负责，与这里无关，所以这个值给得很宽。
# 早期默认 180s，结果长文写到一半（约 1.5 万字）就被静默掐断。
# 真被掐断时会报 finish_reason=length（Anthropic 为 stop_reason=max_tokens），不再伪装成正常结束。
AGENT_HARD_CAP_MS=1800000
# 一帧都没收到（连心跳都没有）的容忍上限，这种情况基本可判定线路不通
AGENT_FIRST_TOKEN_MS=60000
# 心跳正常但还没吐字的容忍上限。-max 系列模型处理长的多轮工具对话时，
# 思考一两分钟很常见（实测 claude-fable-5-max 需要 70s 才出第一个字）。
# 早期把这种情况也按首字超时掐掉，等于在内容到达前放弃，还要换号重试一遍。
AGENT_THINKING_MS=600000

# 排查「感觉很慢」时打开，会为每个请求打印各阶段耗时：
# 读请求体 / 解析消息 / 算 token / 取号(含刷token) / 上游握手 / 上游首个产出 / 流式输出
# 实测一次 15 分钟的 agent 会话：上游思考占 93.8%，握手 0.5%，代理自身 0.03%。
# PROXY_TIMING=1

# 排查上游协议变化时打开，会打印每一帧的字段结构
# AGENT_FRAME_DEBUG=1

# 可选：上游走 HTTP 代理（例如公司外网需要代理时）
# CURSOR_HTTP_PROXY=http://127.0.0.1:7890

# usage 里的 token 如何计算：
#   bpe      （默认）用内嵌词表精确分词，首次用到某编码时加载，常驻约 3～7MB
#   estimate 关闭分词器改用启发式，省这部分内存，精度下降
# 纯对话（客户端没声明 tools）时让上游走 ASK 模式。默认关闭。
#
# ASK 不是通用问答模式，而是 Cursor 里「就代码库提问」的模式：上游会限定模型
# 只回答代码相关的问题。实测模型会拿它当拒绝理由（"I'm in Ask mode, so I can't
# generate creative writing, roleplay content…"），而且这句话进了对话历史后
# 会被反复回放，之后每轮都照着拒绝。
#
# 只用来问代码的话可以打开，能省掉一层「写文件再还原」。
# ASK_MODE=on

TOKENIZER=bpe

# ===== 账号调度 / 防封（默认高并发，可调回保守）=====
ACCOUNT_MIN_INTERVAL_MS=0
ACCOUNT_MAX_CONCURRENCY=64
ACCOUNT_JITTER_MS=0

# 失败后把账号下线多久。两项默认都是 0，也就是「不下线」。
#
# 「失败」这个信号并不可靠：上游抖动、出口区域限制、模型名无效都会被算成账号故障，
# 攒够几次就把一个其实好用的账号隔离半小时，池子小的时候直接变成「无可用账号」。
# 现在改成只降权不下线——最近失败过的账号排到最后但仍然可选，成功一次立刻恢复优先级。
#
# 确实想要老行为（例如账号很多、希望坏号彻底让路）就把时长填回去：
# ACCOUNT_COOLDOWN_429_MS=60000
# ACCOUNT_QUARANTINE_MS=1800000
ACCOUNT_MAX_FAILURES=3
PROXY_MAX_ATTEMPTS=3
ACCOUNT_ACQUIRE_TIMEOUT_MS=30000

# 可选：内置 VPN(Mihomo) 内核直链（不设则自动从 GitHub release 下载）
# MIHOMO_URL=
